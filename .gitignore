# Python cache
__pycache__/
*.py[cod]
# Virtual environments and secrets
.venv/
venv/
.env
# Raw datasets
data/raw/
# Intermediate processed datasets
data/processed/*
!data/processed/final_headlines_cleaned_v2.csv
